<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 取色自 linusonn.com / RTD GUI ============ -->
    <Color x:Key="BgDeepColor">#03040A</Color>
    <Color x:Key="BgPanelColor">#070A16</Color>
    <Color x:Key="CyanColor">#22D3EE</Color>
    <Color x:Key="PurpleColor">#A78BFA</Color>
    <Color x:Key="PinkColor">#F0ABFC</Color>
    <Color x:Key="GreenColor">#22C55E</Color>
    <Color x:Key="RedColor">#F87171</Color>
    <Color x:Key="AmberColor">#FBBF24</Color>

    <SolidColorBrush x:Key="BgDeep" Color="#03040A"/>
    <SolidColorBrush x:Key="Cyan" Color="#22D3EE"/>
    <SolidColorBrush x:Key="Purple" Color="#A78BFA"/>
    <SolidColorBrush x:Key="Pink" Color="#F0ABFC"/>
    <SolidColorBrush x:Key="Green" Color="#22C55E"/>
    <SolidColorBrush x:Key="Red" Color="#F87171"/>
    <SolidColorBrush x:Key="Amber" Color="#FBBF24"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#E8EDF5"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B95A8"/>
    <SolidColorBrush x:Key="TextDim" Color="#4A5468"/>

    <!-- 玻璃面板 / 卡片 -->
    <SolidColorBrush x:Key="GlassFill" Color="#0E1420" Opacity="0.72"/>
    <SolidColorBrush x:Key="GlassFillHover" Color="#141B2A" Opacity="0.85"/>
    <SolidColorBrush x:Key="GlassStroke" Color="#FFFFFF" Opacity="0.08"/>
    <SolidColorBrush x:Key="GlassStrokeHover" Color="#22D3EE" Opacity="0.42"/>
    <SolidColorBrush x:Key="TrackFill" Color="#FFFFFF" Opacity="0.06"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#A78BFA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E8EDF5" Offset="0"/>
        <GradientStop Color="#67E8F9" Offset="0.55"/>
        <GradientStop Color="#C4B5FD" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- ============ 卡片 ============ -->
    <Style x:Key="FeatureCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassFillHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#D6DEEA"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            <Setter Property="Foreground" Value="#67E8F9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作按钮（启动/停止/工具条） -->
    <Style x:Key="PowerButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#E3EAF4"/>
        <Setter Property="Padding" Value="14,7"/>
        <!-- 样式内必须显式给前景色：不设会落到系统默认的黑色，在深色底上完全看不清 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="9"
                            Background="#14000000"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
