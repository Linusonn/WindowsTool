<Window x:Class="WindowsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsTool.Controls"
        Title="Windows Tool"
        Width="1140" Height="780"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Border CornerRadius="18" ClipToBounds="True"
            BorderBrush="#1FFFFFFF" BorderThickness="1">
        <Grid>
            <!-- 星野粒子背景 -->
            <controls:StarfieldBackground x:Name="Starfield"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <!-- ===== 标题栏（可拖动） ===== -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock Text="✦" FontSize="17" Foreground="{StaticResource Cyan}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="WINDOWS TOOL" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TitleGradient}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="本地服务控制台" FontSize="11.5"
                                   Foreground="{StaticResource TextDim}"
                                   Margin="12,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                        <Button Content="—" Style="{StaticResource IconButton}" Width="38" Height="30"
                                Padding="0" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource IconButton}" Width="38" Height="30"
                                Padding="0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ===== 概览 + 操作 ===== -->
                <Grid Grid.Row="1" Margin="22,2,22,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="RunningCountText" Text="0" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGradient}" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="运行中" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TotalCountText" Text="/ 0 项功能" FontSize="11"
                                       Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="全部启动" Style="{StaticResource PowerButton}" Margin="0,0,8,0"
                                Background="#1422D3EE" Click="StartAll_Click"/>
                        <Button Content="全部停止" Style="{StaticResource PowerButton}" Margin="0,0,8,0"
                                Click="StopAll_Click"/>
                        <Button Content="刷新" Style="{StaticResource PowerButton}" Margin="0,0,8,0"
                                Click="Refresh_Click"/>
                        <Button Content="配置文件" Style="{StaticResource PowerButton}"
                                Click="Config_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ===== 功能卡片 ===== -->
                <ScrollViewer Grid.Row="2" Margin="22,0,8,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FeatureList" Margin="0,0,14,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FeatureCard}" Width="332">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 名称 + 状态灯 + 分类 -->
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Width="14" Height="14" VerticalAlignment="Center">
                                                    <Ellipse x:Name="Halo" Width="14" Height="14" Opacity="0"/>
                                                    <Ellipse x:Name="Dot" Width="8" Height="8"
                                                             Fill="{StaticResource TextDim}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="#2622D3EE" CornerRadius="6" Padding="8,2.5"
                                                    BorderBrush="#4422D3EE" BorderThickness="1">
                                                <TextBlock Text="{Binding Category}" FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8BE9F7"/>
                                            </Border>
                                        </Grid>

                                        <!-- 描述 -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                   TextWrapping="Wrap" FontSize="11.5" MinHeight="32"
                                                   Foreground="#7E8AA0" Margin="24,9,0,0"/>

                                        <!-- 状态 + 启停 -->
                                        <Grid Grid.Row="2" Margin="24,12,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="#9AA6BC"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button HorizontalAlignment="Right" MinWidth="66"
                                                    Style="{StaticResource PowerButton}"
                                                    Click="ToggleFeature_Click">
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="启动"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource TextPrimary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Running">
                                                                    <Setter Property="Text" Value="停止"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource Pink}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="Text" Value="···"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Cyan}"/>
                                        <Setter TargetName="Halo" Property="Opacity" Value="1">
                                        </Setter>
                                        <Setter TargetName="Halo" Property="Fill" Value="{StaticResource Cyan}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Starting">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Amber}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Stopping">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Amber}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Red}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Unknown">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextDim}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ===== 状态栏 ===== -->
                <Grid Grid.Row="3" Margin="22,0,22,0">
                    <TextBlock x:Name="StatusBarText" FontSize="11"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConfigPathText" FontSize="10.5" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
